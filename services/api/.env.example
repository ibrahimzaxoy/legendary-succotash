NODE_ENV=development
PORT=3000

DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=restaurant
DB_PASSWORD=restaurant
DB_DATABASE=restaurant

JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d

# Base URL used to build the table QR ordering links, e.g. https://order.example.com
TABLE_ORDER_BASE_URL=http://localhost:3001

# Web Push (order-status notifications). Generate a real pair with
# `npx web-push generate-vapid-keys` for anything beyond local dev - if
# left unset, the server generates an ephemeral pair at boot and logs a
# warning (existing subscriptions stop working on restart).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
